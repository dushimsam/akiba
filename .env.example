# ---- PostgreSQL (used by docker-compose.yml) ----
POSTGRES_USER=akiba
POSTGRES_PASSWORD=changeme
POSTGRES_DB=akiba
POSTGRES_PORT=5432

# ---- Server ----
SERVER_PORT=3000
NODE_ENV=development
# Connection string the server uses. In docker-compose this is set
# automatically from the POSTGRES_* values above.
DATABASE_URL=postgres://akiba:changeme@postgres:5432/akiba
# Set to "true" when connecting to a TLS-only database such as AWS RDS.
DATABASE_SSL=false

# ---- Client ----
CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000/api

# ---- Local (Host-to-Docker) Dev Override ----
# DATABASE_URL=postgres://akiba:changeme@localhost:5432/akiba
