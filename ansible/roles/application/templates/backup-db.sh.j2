set -e
BACKUP_DIR="/opt/akiba/backups"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="$BACKUP_DIR/akiba_backup_$TIMESTAMP.sql.gz"
CONTAINER_NAME="akiba-postgres"
DB_NAME="{{ postgres_db | default('akiba') }}"
DB_USER="{{ postgres_user | default('akiba') }}"
mkdir -p "$BACKUP_DIR"
echo "Starting PostgreSQL backup for $DB_NAME database..."
if ! docker ps | grep -q "$CONTAINER_NAME"; then
    echo "Error: PostgreSQL container is not running"
    exit 1
fi
docker exec "$CONTAINER_NAME" pg_dump -U "$DB_USER" -d "$DB_NAME" | gzip > "$BACKUP_FILE"
find "$BACKUP_DIR" -name "akiba_backup_*.sql.gz" -mtime +7 -delete
echo "Backup completed successfully: $BACKUP_FILE"
echo "Backup file size: $(du -h $BACKUP_FILE | cut -f1)"
