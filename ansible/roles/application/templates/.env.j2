NODE_ENV={{ node_env | default('production') }}
PORT={{ server_port | default(3000) }}
SERVER_PORT={{ server_port | default(3000) }}
POSTGRES_USER={{ postgres_user | default('akiba') }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db | default('akiba') }}
POSTGRES_PORT={{ postgres_port | default(5432) }}
DATABASE_URL=postgres://{{ postgres_user | default('akiba') }}:{{ postgres_password }}@postgres:5432/{{ postgres_db | default('akiba') }}
DATABASE_SSL={{ database_ssl | default('false') }}
LOG_LEVEL={{ log_level | default('info') }}
CORS_ORIGIN={{ cors_origin | default('*') }}
DEPLOYMENT_ENV={{ server_env | default('production') }}
REGION={{ region | default('KGL-1') }}
APP_VERSION={{ app_version | default('1.0.0') }}
