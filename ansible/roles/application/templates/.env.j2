NODE_ENV={{ node_env | default('production') }}
PORT={{ server_port | default(3000) }}
SERVER_PORT={{ server_port | default(3000) }}
MONGO_ROOT_USERNAME={{ mongodb_user | default('root') }}
MONGO_ROOT_PASSWORD={{ mongodb_password }}
MONGO_DB_NAME={{ mongo_db_name | default('akiba') }}
MONGO_PORT=27017
MONGODB_URI=mongodb://{{ mongodb_user | default('root') }}:{{ mongodb_password }}@localhost:27017/{{ mongo_db_name | default('akiba') }}?authSource=admin
LOG_LEVEL={{ log_level | default('info') }}
CORS_ORIGIN={{ cors_origin | default('*') }}
DEPLOYMENT_ENV={{ server_env | default('production') }}
REGION={{ region | default('KGL-1') }}
APP_VERSION={{ app_version | default('1.0.0') }}
