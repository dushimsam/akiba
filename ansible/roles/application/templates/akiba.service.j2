[Unit]
Description=AKIBA Application (Docker Compose)
Requires=docker.service
After=docker.service
PartOf=docker.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/akiba
EnvironmentFile=/opt/akiba/.env
ExecStart=/usr/local/bin/docker-compose -f /opt/akiba/docker-compose.yml up -d
ExecStop=/usr/local/bin/docker-compose -f /opt/akiba/docker-compose.yml down
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=akiba
[Install]
WantedBy=multi-user.target
